# Formulaire de contact — voir docs/SETUP-CONTACT.md

# URL publique du site (canoniques, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend : envoi du mail de demande
RESEND_API_KEY=
CONTACT_TO=helloocm.agency@gmail.com
# Sans domaine vérifié, garder l'expéditeur de test de Resend
CONTACT_FROM=C&M Agency <onboarding@resend.dev>

# Clé de signature des demandes : à copier depuis le back-office
# (page « Demandes » > Connexion au site). Sans elle, le BO ignore les demandes.
LEAD_SIGNING_KEY=

# Cloudflare Turnstile (anti-robot). Vides = désactivé.
# Clés de test publiques de Cloudflare (toujours valides), pour le dev :
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
